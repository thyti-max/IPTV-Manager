# Sandbox-only defaults for docker-compose.base44.yml (committed on purpose so the
# preview boots with no credentials). Compose loads /run/base44/app.env AFTER this
# file, so any real value from the Base44 secrets dashboard overrides these.
#
# No external service credentials are required to run IPTV-Manager: the JWT and
# provider-password keys are generated into DATA_DIR on first boot, and IPTV
# provider accounts plus the optional MaxMind license key are added in the Web UI.
#
# Dev-only admin login for the fresh sandbox database. The app creates user
# `admin` on first boot and requires a password change at first sign-in, so this
# value never survives as a real credential.
INITIAL_ADMIN_PASSWORD=base44-dev-admin

# The personal-ChatGPT (Codex) runtime is not provisioned in this stack; the
# project's own docker-compose.yml disables it the same way.
AI_CODEX_ENABLED=false
